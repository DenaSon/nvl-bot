[Unit]
Description=DenaProbe DPT/1 isolated HTTPS-tunnel collector
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=denaprobe
Group=denaprobe
WorkingDirectory=/opt/nvl-dpt-collector
ExecStart=/usr/bin/python3 /opt/nvl-dpt-collector/denaprobe_ingest/collector.py --db /var/lib/denaprobe/telemetry.sqlite3 --keys /var/lib/denaprobe/devices.json serve --host 127.0.0.1 --port 18081
Restart=on-failure
RestartSec=3
UMask=0077
StateDirectory=denaprobe
StateDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/denaprobe
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
MemoryMax=128M
TasksMax=24

[Install]
WantedBy=multi-user.target
