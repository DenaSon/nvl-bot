# Copy to /etc/nvlbot/denaprobe.env with 0600 permissions.
# Generate an independent random token of at least 32 chars per device.
# Never reuse the Telegram bot token, SSH passwords or Core credentials.
DENAPROBE_DB_PATH=/var/lib/nvl-denaprobe/telemetry.sqlite3
DENAPROBE_PORT=8765
DENAPROBE_EDGE_HOST=CHANGE_ME_PUBLIC_EDGE_HOST
DENAPROBE_DEVICE_TOKENS_JSON='{"probe_01":"REPLACE_WITH_RANDOM_64_HEX_CHAR_DEVICE_ONLY_SECRET"}'
