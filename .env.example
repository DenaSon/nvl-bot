# Required
BOT_TOKEN=
MASTER_USER=
MASTER_PASS=

# Required for RED/BLUE global confirmation operations.
# Keep this secret and set it explicitly in production.
RB_CONFIRM_PASS=

# Optional paths
BOT_DB_PATH=/root/master_bot.db
BOT_PERSISTENCE_PATH=/root/bot_persistence.pickle

# Marzban bootstrap/runtime configuration.
# Do not commit real values.
MARZBAN_URL=https://gate.nvlsup.xyz
MARZBAN_USERNAME=
MARZBAN_PASSWORD=

# V123C — Cloudflare DNS automation for Marzban Stable Public Endpoints.
# Token should have DNS Write; Zone Read is required only when ZONE_ID is omitted.
NVL_CLOUDFLARE_API_TOKEN=
# Optional but recommended: exact zone ID that owns argus.nvlsup.xyz.
NVL_CLOUDFLARE_ZONE_ID=

# Radar V1 — read-only Cloudflare Radar client.
# Use a dedicated token authorized to read Cloudflare Radar data.
NVL_CLOUDFLARE_RADAR_API_TOKEN=
NVL_CLOUDFLARE_RADAR_TIMEOUT=8
NVL_CLOUDFLARE_RADAR_RETRIES=2
NVL_CLOUDFLARE_RADAR_BACKOFF_BASE=0.5
NVL_CLOUDFLARE_RADAR_BACKOFF_MAX=8

# Radar V2 — runtime network context snapshots (monitor-only).
NVL_RADAR_LOCATION=IR
NVL_RADAR_INTERVAL=600
NVL_RADAR_INITIAL_DELAY=45
NVL_RADAR_RETENTION_DAYS=14

# Radar V3 — low-noise transition notifications.
NVL_RADAR_DEGRADED_CONFIRM_ROUNDS=2
NVL_RADAR_RECOVERY_CONFIRM_ROUNDS=2
