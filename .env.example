# Required
BOT_TOKEN=
MASTER_USER=
MASTER_PASS=

# Required for RED/BLUE global confirmation operations.
# Keep this secret and set it explicitly in production.
RB_CONFIRM_PASS=

# Optional paths
BOT_DB_PATH=/root/master_bot.db
BOT_PERSISTENCE_PATH=/root/bot_persistence.pickle

# Marzban Infrastructure Check-Host alerting (Telegram group only).
# Set a real negative Telegram group/supergroup chat id in the Core service environment.
# If absent/invalid, these notifications are not delivered; no admin DM fallback.
MARZBAN_ALERT_ENABLED=1
MARZBAN_ALERT_CHAT_ID=
MARZBAN_ALERT_CONFIRM_SCANS=3
MARZBAN_ALERT_COOLDOWN_MINUTES=60

# NVL Daily Business Report: durable event-ledger and group-only daily digest.
# Starts tracking NEW business events as soon as the code is deployed.
# Enable Telegram delivery only after deployment and successful group test.
NVL_DAILY_FINANCE_REPORT_ENABLED=0
NVL_DAILY_FINANCE_REPORT_CHAT_ID=
NVL_DAILY_FINANCE_REPORT_TIME=00:05
NVL_DAILY_FINANCE_REPORT_TZ=Asia/Tehran

# Marzban bootstrap/runtime configuration.
# Do not commit real values.
MARZBAN_URL=https://gate.nvlsup.xyz
MARZBAN_USERNAME=
MARZBAN_PASSWORD=

# New-node provisioning only. Pin Xray independently of marzban-node:latest.
# Changing this does NOT update running nodes.
NVL_MARZBAN_NODE_XRAY_VERSION=26.6.1

# V123C — Cloudflare DNS automation for Marzban Stable Public Endpoints.
# Token should have DNS Write; Zone Read is required only when ZONE_ID is omitted.
NVL_CLOUDFLARE_API_TOKEN=
# Optional but recommended: exact zone ID that owns argus.nvlsup.xyz.
NVL_CLOUDFLARE_ZONE_ID=

# Radar V1 — read-only Cloudflare Radar client.
# Use a dedicated token authorized to read Cloudflare Radar data.
NVL_CLOUDFLARE_RADAR_API_TOKEN=
NVL_CLOUDFLARE_RADAR_TIMEOUT=8
NVL_CLOUDFLARE_RADAR_RETRIES=2
NVL_CLOUDFLARE_RADAR_BACKOFF_BASE=0.5
NVL_CLOUDFLARE_RADAR_BACKOFF_MAX=8

# Radar V2 — runtime network context snapshots (monitor-only).
NVL_RADAR_LOCATION=IR
NVL_RADAR_INTERVAL=600
NVL_RADAR_INITIAL_DELAY=45
NVL_RADAR_RETENTION_DAYS=14

# Radar V3 — low-noise transition notifications.
NVL_RADAR_DEGRADED_CONFIRM_ROUNDS=2
NVL_RADAR_RECOVERY_CONFIRM_ROUNDS=2

# Legacy Edge monitor Telegram notices (OFF by default).
# Controls ONLY these messages: repeated service health failures, confirmed
# regional filtering, and automatic failover BLOCKED decisions.
# Monitoring, incident journal, 6H safety gates and real failover failure
# notifications are unaffected. Set 1 only to opt back in.
NVL_EDGE_MONITOR_ALERTS_ENABLED=0

# Radar V4 — freshness window for the AUTO failover safety gate only.
NVL_RADAR_FAILOVER_CONTEXT_MAX_AGE=1200

# DenaProbe R3 — existing admin Telegram bot (pilot default OFF).
# The Collector does NOT read these; never store the HMAC secret in this .env.
NVL_DENAPROBE_R3_ENABLED=0
NVL_DENAPROBE_R3_ALERTS_ENABLED=0
NVL_DENAPROBE_DB_PATH=/var/lib/denaprobe/telemetry-r3.sqlite3
